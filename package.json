{
  "name": "smallauthplatform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "init": "pnpm --dir ./web install",
    "deps": "pnpm --dir ./web install",
    "dev": "pnpm dev:admin-web",
    "dev:admin-web": "node ./scripts/dev.mjs admin-web",
    "dev:admin-server": "node ./scripts/dev.mjs admin-server",
    "dev:h5-web": "node ./scripts/dev.mjs h5-web",
    "dev:h5-server": "node ./scripts/dev.mjs h5-server",
    "backend:deps": "mvn -f ./server/pom.xml dependency:resolve"
  }
}

{
  "name": "vue-scaffold-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "pnpm --filter @vue-scaffold/admin dev",
    "dev:h5": "pnpm --filter @vue-scaffold/h5 dev",
    "dev:test": "pnpm --filter @vue-scaffold/admin dev:test",
    "dev:prod": "pnpm --filter @vue-scaffold/admin dev:prod",
    "build": "pnpm --filter @vue-scaffold/admin build",
    "build:h5": "pnpm --filter @vue-scaffold/h5 build",
    "build:test": "pnpm --filter @vue-scaffold/admin build:test",
    "build:h5-test": "pnpm --filter @vue-scaffold/h5 build:test",
    "build:dist": "pnpm --filter @vue-scaffold/admin build:test",
    "build:prod": "pnpm --filter @vue-scaffold/admin build:prod",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.5",
    "@types/node": "^24.2.1",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "sass": "^1.79.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vue-tsc": "^3.0.5"
  }
}
